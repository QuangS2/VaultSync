# Multi-Stage Build: VaultSync Frontend SPA (< 25MB Nginx Alpine)
FROM node:20-alpine AS builder

WORKDIR /app

# Cache dependencies layer
COPY package*.json ./
RUN npm ci

# Copy source files required for frontend build
COPY tsconfig.json vite.config.ts postcss.config.js tailwind.config.js index.html ./
COPY client/ ./client/
COPY shared/ ./shared/

# Build optimized production bundle
RUN npm run build:client

# Production Stage: Ultra-lightweight Nginx Alpine
FROM nginx:1.27-alpine-slim AS runner

# Clean default assets
RUN rm -rf /etc/nginx/conf.d/* /usr/share/nginx/html/*

# Copy configuration and built assets
COPY docker/nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

# Built-in Healthcheck
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
