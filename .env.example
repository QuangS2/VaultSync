# ==============================================================================
# VaultSync Environment Configuration Template
# Copy this file to .env.production on your server and update values
# ==============================================================================

# Domain Configuration
DOMAIN_NAME=vaultsync.example.com
LETSENCRYPT_EMAIL=admin@example.com

# GitHub Container Registry Image Tags
GITHUB_REPOSITORY_OWNER=quangs2
IMAGE_TAG=latest
FRONTEND_IMAGE=ghcr.io/quangs2/vaultsync-frontend:latest
RELAY_IMAGE=ghcr.io/quangs2/vaultsync-server:latest

# Security Credentials
REDIS_PASSWORD=replace_with_strong_random_secret_string_here

# Relay Server Internal Port & Host
RELAY_PORT=1234
RELAY_HOST=0.0.0.0
NODE_ENV=production
